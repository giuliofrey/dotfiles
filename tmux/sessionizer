#!/bin/sh
# Project picker for tmux. Lists every git repo under ~/personal, ~/projects and
# ~/.config, most recently committed first, and attaches to (or creates) a
# session rooted there. Bound to prefix+f in tmux.conf via display-popup.
#
#   sessionizer          picker; enter opens a shell, ctrl-o the split layout
#   sessionizer DIR      skip the picker, open DIR with the split layout
#   sessionizer --list   print the ordering without the fzf UI
#
# The DIR form is what prefix+F and the `ts` abbreviation use to open whatever
# directory you are already in, without going through fzf.

set -eu

ROOTS="$HOME/personal $HOME/projects $HOME/.config"
DEPTH=10   # directory levels below each root to search

# Sort key is the last commit timestamp, not mtime: mtime churns on any git
# operation, so it answers "which repo did git touch last" rather than "which
# project did I last work on".
#
# Virtualenvs dominate the walk (28k of 38k directories here) and never hold a
# project worth opening, so pruning them takes find from 0.38s to 0.06s and
# finds the same repos. Nested repos are still listed.
#
# A repo with no commits exits non-zero under xargs, so it scores 0 and sorts
# last rather than vanishing from the list.
PRUNE='-name .venv -o -name venv -o -name node_modules -o -name __pycache__'
list_repos() {
	for root in $ROOTS; do
		[ -d "$root" ] || continue
		# shellcheck disable=SC2086
		find "$root" -maxdepth $((DEPTH + 1)) \
			\( -type d \( $PRUNE \) -prune \) -o \
			\( -type d -name .git -prune -print \) 2>/dev/null
	done | sed 's|/\.git$||' \
	| xargs -P 8 -I{} sh -c \
		'printf "%s\t%s\n" "$(git -C "$1" log -1 --format=%ct 2>/dev/null || echo 0)" "$1"' _ {} \
	| sort -rn | cut -f2
}

# Basenames repeat at this depth (two "website" repos, two "draft"). Naming both
# by basename would silently switch to the first, so a name already taken by a
# different directory gets qualified with its parent.
session_name() {
	base=$(basename "$1" | tr '.:' '__')
	# list-sessions -f, not display-message -t: the latter takes a target pane, so
	# a session name resolves to nothing and the collision check never fires.
	taken=$(tmux list-sessions -F '#{session_path}' \
		-f "#{==:#{session_name},$base}" 2>/dev/null) || taken=""
	if [ -n "$taken" ] && [ "$taken" != "$1" ]; then
		base="$(basename "$(dirname "$1")" | tr '.:' '__')-$base"
	fi
	printf '%s' "$base"
}

# Paths are shown relative to $HOME so the list stays readable in a narrow
# popup; the prefix goes back on after selection.
if [ "${1:-}" = "--list" ]; then
	list_repos | sed "s|^$HOME/|~/|"
	exit 0
fi

# A directory argument skips the picker and always takes the split layout, since
# that is the point of this form. cd -P resolves symlinks and a relative "." so
# the session name and pane paths agree with what tmux reports.
if [ -n "${1:-}" ]; then
	[ -d "$1" ] || { echo "not a directory: $1"; sleep 2; exit 1; }
	dir=$(cd -P "$1" && pwd)
	key=split
else

# A popup that vanishes instantly is miserable to debug, so say why.
command -v fzf >/dev/null 2>&1 || { echo "fzf not found in PATH"; sleep 3; exit 1; }

repos=$(list_repos)
[ -n "$repos" ] || { echo "no git repos under $ROOTS"; sleep 2; exit 1; }

# --expect prints the confirming key as the first output line, blank for a plain
# Enter, and the selection as the second. --no-sort keeps the commit ordering
# once you start typing, which fzf's own fuzzy score would otherwise override.
#
# ctrl-o, not shift-enter: fzf rejects that one, and alt-enter needs
# `macos-option-as-alt` in ghostty, which is unset here.
#
# $HOME/{} stays unquoted: fzf substitutes {} already shell-quoted, so quoting it
# again yields /Users/giulio/'projects/foo', which does not exist.
#
# Comments stay above the command: a `\` continuation splices the next line on,
# so a comment between continued arguments ends the command there. That silently
# dropped --preview once.
picked=$(printf '%s\n' "$repos" | sed "s|^$HOME/||" | fzf \
	--prompt='project> ' \
	--height=100% \
	--reverse \
	--border=none \
	--expect=ctrl-o,alt-enter \
	--no-sort \
	--header='enter: shell    ctrl-o: lazygit + claude' \
	--preview='git -C $HOME/{} log -1 --format="%cr%n%s" 2>/dev/null || echo "no commits"' \
	--preview-window=down,2,border-top) || exit 0

key=$(printf '%s\n' "$picked" | sed -n 1p)
selected=$(printf '%s\n' "$picked" | sed -n 2p)

[ -n "$selected" ] || exit 0

dir="$HOME/$selected"
fi

name=$(session_name "$dir")

# Enter opens a bare shell, ctrl-o the 50/50 split of lazygit and claude. Runs
# only on creation, so re-selecting a project returns you to it as you left it
# rather than stacking another split.
#
# Panes are addressed by id (%N) from -P, not index: pane-base-index is 1, so
# hardcoded .0/.1 would break if that changed.
#
# send-keys rather than passing the command to new-session/split-window: a pane
# started with a command dies when it exits, so quitting lazygit would collapse
# the layout.
if ! tmux has-session -t="$name" 2>/dev/null; then
	if [ -n "$key" ]; then
		left=$(tmux new-session -ds "$name" -c "$dir" -P -F '#{pane_id}')
		right=$(tmux split-window -h -t "$left" -c "$dir" -P -F '#{pane_id}')
		tmux send-keys -t "$left" lazygit C-m
		# $PWD is expanded by the pane's own shell, already rooted at $dir.
		# Unquoted is safe because fish does not word-split variables.
		tmux send-keys -t "$right" 'claude agents --cwd $PWD' C-m
		# split-window leaves the new pane active, so you land on claude.
	else
		tmux new-session -ds "$name" -c "$dir"
	fi
fi

# switch-client works from inside tmux (the popup case); attach covers running
# this straight from a shell.
if [ -n "${TMUX:-}" ]; then
	tmux switch-client -t "$name"
else
	tmux attach-session -t "$name"
fi
