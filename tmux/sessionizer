#!/bin/sh
# Project picker for tmux. Lists every git repo directly under ~/personal and
# ~/projects, most recently committed first, and attaches to (or creates) a
# session rooted there. Bound to prefix+f in tmux.conf via display-popup.
#
# Run `sessionizer --list` to see the ordering without the fzf UI.

set -eu

ROOTS="$HOME/personal $HOME/projects"
DEPTH=10   # directory levels below each root to search

# Sort key is the last commit timestamp, not directory mtime: mtime churns on
# any git operation (fetch, checkout, even status), so it answers "which repo
# did git touch last" rather than "which project did I last work on".
#
# -prune stops find descending into .git itself. Repos nested inside other
# repos (submodules, vendored code) are still listed, since opening one as its
# own session is a reasonable thing to want.
#
# Virtualenvs are pruned because they dominate the walk: of the 38k directories
# under these roots, 28k are inside .venv/venv. Skipping them takes find from
# 0.38s to 0.06s and finds exactly the same repos. A repo that lives inside a
# virtualenv is not a project you open.
#
# The git calls run under xargs -P: a repo with no commits exits non-zero, so
# it scores 0 and sorts last rather than vanishing from the list.
PRUNE='-name .venv -o -name venv -o -name node_modules -o -name __pycache__'
list_repos() {
	for root in $ROOTS; do
		[ -d "$root" ] || continue
		# shellcheck disable=SC2086
		find "$root" -maxdepth $((DEPTH + 1)) \
			\( -type d \( $PRUNE \) -prune \) -o \
			\( -type d -name .git -prune -print \) 2>/dev/null
	done | sed 's|/\.git$||' \
	| xargs -P 8 -I{} sh -c \
		'printf "%s\t%s\n" "$(git -C "$1" log -1 --format=%ct 2>/dev/null || echo 0)" "$1"' _ {} \
	| sort -rn | cut -f2
}

# Searching 10 levels deep means basenames repeat: there are two "website"
# repos and two "draft" repos. Naming both sessions by basename would make the
# second selection silently switch to the first project instead of opening the
# one asked for, so a name already taken by a different directory gets
# qualified with its parent.
session_name() {
	base=$(basename "$1" | tr '.:' '__')
	# list-sessions -f, not display-message -t: display-message takes a target
	# pane, so a session name silently resolves to nothing and the collision
	# check never fires. This form returns the path, or empty if no such session.
	taken=$(tmux list-sessions -F '#{session_path}' \
		-f "#{==:#{session_name},$base}" 2>/dev/null) || taken=""
	if [ -n "$taken" ] && [ "$taken" != "$1" ]; then
		base="$(basename "$(dirname "$1")" | tr '.:' '__')-$base"
	fi
	printf '%s' "$base"
}

# Paths are shown relative to $HOME so the list stays readable in a narrow
# popup; the prefix goes back on after selection.
if [ "${1:-}" = "--list" ]; then
	list_repos | sed "s|^$HOME/|~/|"
	exit 0
fi

# A popup that vanishes instantly is miserable to debug, so say why.
command -v fzf >/dev/null 2>&1 || { echo "fzf not found in PATH"; sleep 3; exit 1; }

repos=$(list_repos)
[ -n "$repos" ] || { echo "no git repos under $ROOTS"; sleep 2; exit 1; }

selected=$(printf '%s\n' "$repos" | sed "s|^$HOME/||" | fzf \
	--prompt='project> ' \
	--height=100% \
	--reverse \
	--border=none \
	--preview='git -C "$HOME/{}" log -1 --format="%cr%n%s" 2>/dev/null || echo "no commits"' \
	--preview-window=down,2,border-top) || exit 0

[ -n "$selected" ] || exit 0

dir="$HOME/$selected"
name=$(session_name "$dir")

# New sessions open as a 50/50 split: lazygit left, claude right. This runs
# only on creation, so re-selecting a project returns you to it as you left it
# rather than stacking another split every time.
#
# The panes are addressed by pane id (%N) captured from -P, not by index:
# pane-base-index is 1 in tmux.conf, so hardcoded .0/.1 would target the wrong
# pane the moment that setting changed.
#
# send-keys rather than passing the command to new-session/split-window: a pane
# started with a command dies when that command exits, so quitting lazygit
# would collapse the layout. This leaves a shell behind instead.
if ! tmux has-session -t="$name" 2>/dev/null; then
	left=$(tmux new-session -ds "$name" -c "$dir" -P -F '#{pane_id}')
	right=$(tmux split-window -h -t "$left" -c "$dir" -P -F '#{pane_id}')
	tmux send-keys -t "$left" lazygit C-m
	tmux send-keys -t "$right" claude C-m
	# split-window leaves the new pane active, so you land on claude.
fi

# switch-client works from inside tmux (the popup case); attach covers running
# this straight from a shell.
if [ -n "${TMUX:-}" ]; then
	tmux switch-client -t "$name"
else
	tmux attach-session -t "$name"
fi
