#!/usr/bin/env python3
"""Give Herdr and Rex agent panes a project fallback and a short task title."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import select
import socket
import subprocess
import sys
import time

SOURCE = "local:task-title"
STATE_ROOT = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "herdr/task-titles"
GENERIC_TITLES = {
    "claude": {"claude", "claude code"},
    "pi": {"pi", "π"},
    "codex": {"codex"},
    "cursor": {"cursor", "cursor agent"},
}


def clean_text(value):
    value = re.sub(r"[\x00-\x1f\x7f]", " ", str(value or ""))
    return re.sub(r"\s+", " ", value).strip()


def project_name(cwd):
    cwd = Path(cwd or os.getcwd()).expanduser()
    try:
        root = subprocess.run(
            ["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        ).stdout.strip()
        if root:
            cwd = Path(root)
    except (OSError, subprocess.CalledProcessError):
        pass
    return cwd.resolve().name or "terminal"


def shorten_prompt(prompt):
    text = clean_text(prompt)
    text = re.sub(r"^/[A-Za-z0-9:_-]+\s*", "", text)
    text = re.sub(
        r"^(?:ok(?:ay)?\s+|now\s+|please\s+|can (?:we|you)\s+|could you\s+|"
        r"would you\s+|help me\s+|i (?:want|need) (?:you )?to\s+|let(?:'|’)s\s+)+",
        "",
        text,
        flags=re.IGNORECASE,
    )
    text = re.sub(r"^[^\w]+|[.!?,;:]+$", "", text)
    words = text.split()
    if not words:
        return ""
    title = " ".join(words[:6])
    if len(title) > 48:
        title = title[:48].rsplit(" ", 1)[0] or title[:48]
    return title[0].upper() + title[1:]


def state_path(kind, session_id, pane_id):
    identity = session_id or pane_id
    digest = hashlib.sha256(f"{kind}\0{identity}".encode()).hexdigest()[:24]
    return STATE_ROOT / f"{kind}-{digest}.json"


def read_state(path):
    try:
        value = json.loads(path.read_text())
        if isinstance(value.get("title"), str):
            return value
    except (OSError, ValueError, AttributeError):
        pass
    return None


def write_state(path, title, provisional):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps({"title": title, "provisional": provisional}) + "\n")
    os.replace(temporary, path)


def request(method, params):
    socket_path = os.environ.get("HERDR_SOCKET_PATH")
    if os.environ.get("HERDR_ENV") != "1" or not socket_path:
        return {}
    message = {"id": f"{SOURCE}:{time.time_ns()}", "method": method, "params": params}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(0.5)
            client.connect(socket_path)
            client.sendall((json.dumps(message) + "\n").encode())
            with client.makefile("r") as response:
                return json.loads(response.readline())
    except (OSError, ValueError):
        return {}


def report(kind, pane_id, title):
    if not pane_id:
        return
    request("pane.report_metadata", {
        "pane_id": pane_id,
        "source": SOURCE,
        "agent": kind,
        "seq": time.time_ns(),
        "tokens": {"task": title},
    })


def agent_name(title, pane_id):
    """Slug for `herdr agent rename`: [a-z][a-z0-9_-]{0,31}, unique among live agents."""
    name = re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", title.lower())).strip("-")
    name = re.sub(r"^[^a-z]+", "", name)[:32].rstrip("-")
    return name


def rename_agent(name, pane_id):
    # Names make an agent addressable as `herdr agent prompt <name>`, so a task
    # title beats a pane ID for anything that talks to another pane. Renaming to
    # the name this pane already holds is a no-op, so this can run every hook.
    result = request("agent.rename", {"target": pane_id, "name": name})
    return result.get("error", {}).get("code", "")


def name_agent(title, pane_id):
    if os.environ.get("HERDR_ENV") != "1" or not pane_id:
        return
    name = agent_name(title, pane_id)
    if not name:
        return
    if rename_agent(name, pane_id) != "agent_name_taken":
        return
    # Two panes on the same task: fall back to a name carrying the pane ID.
    suffix = re.sub(r"[^a-z0-9]", "", pane_id.lower())
    rename_agent(f"{name[:31 - len(suffix)]}-{suffix}", pane_id)


def rex_command(*args):
    try:
        result = subprocess.run(
            ["rex", "--autostart=false", "--timeout", "2s", *args],
            check=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, timeout=3,
        )
        return json.loads(result.stdout or "{}")
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def rex_label(resource, identity, actual, desired):
    path = state_path("rex-" + resource, identity, "")
    previous = read_state(path)
    defaults = {resource.title() + " " + identity[-8:]}
    defaults.update({"shell"} if resource == "block" else {"Terminal"})
    if actual not in defaults and (not previous or actual != previous["title"]):
        return actual
    if actual == desired or rex_command(
        resource, "rename", "-s", os.environ["REX_SESSION"], identity, desired
    ) is not None:
        write_state(path, desired, False)
        return desired
    return actual


def report_rex(kind, pane_id, title):
    view = rex_command("session", "inspect", os.environ["REX_SESSION"], "--json")
    if not view:
        return
    for window in view.get("windows", []):
        blocks = [block for layer in window.get("layers", []) for block in layer.get("blocks", [])]
        for block in blocks:
            if block["block_id"] != pane_id:
                continue
            harness = {"pi": "Pi", "claude": "Claude", "codex": "Codex",
                       "cursor": "Cursor"}[kind]
            label = rex_label("block", pane_id, block["label"], f"{harness} · {title}"[:128])
            # A split tab belongs to all its panes, not whichever agent reports last.
            rex_label("window", window["window_id"], window["label"],
                      label if len(blocks) == 1 else "Terminal")
            # Hooks capture stdout; emit OSC to the terminal, never type it as input.
            try:
                with open("/dev/tty", "w") as terminal:
                    terminal.write(f"\033]2;{clean_text(label)}\007")
            except OSError:
                pass
            return


def native_title(kind, pane_id, fallback):
    if pane_id.startswith("block:") and os.environ.get("HERDR_ENV") != "1":
        result = rex_command("block", "call", "-s", os.environ["REX_SESSION"], "-b", pane_id, "title")
        title = clean_text((result or {}).get("title"))
        title = re.sub(r"^(?:Pi|Claude|Codex|Cursor) · ", "", title)
    else:
        try:
            output = subprocess.run(
                ["herdr", "pane", "get", pane_id],
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
            ).stdout
            title = clean_text(json.loads(output)["result"]["pane"].get("terminal_title_stripped"))
        except (OSError, subprocess.CalledProcessError, KeyError, TypeError, ValueError):
            return ""
    lowered = title.lower()
    if not title or lowered == fallback.lower() or lowered in GENERIC_TITLES.get(kind, set()):
        return ""
    if re.fullmatch(r"(?:[0-9a-f]{8}-?){2,}|01[a-z0-9-]{20,}", lowered):
        return ""
    if lowered.startswith(("no space left", "action required", "working", "thinking")):
        return ""
    # Herdr's own pane title is "<command> ~/short/cwd", which a harness that has
    # not set a title of its own leaves in place: "codex ~/p/learning-to-price".
    if re.search(r"\s~/\S*$", title):
        return ""
    if kind == "pi" and (title.startswith("π - ") or title.startswith("Pi - ")):
        return ""
    return title[:64]


def payload_value(payload, *names):
    for name in names:
        value = payload.get(name)
        if isinstance(value, str) and value.strip():
            return value
    return ""


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("kind", choices=tuple(GENERIC_TITLES))
    parser.add_argument("--title")
    parser.add_argument("--cwd")
    parser.add_argument("--session")
    parser.add_argument("--pane")
    parser.add_argument("--native", action="store_true")
    args = parser.parse_args()

    # Explicit titles need no hook payload: do not wait on an open stdin pipe.
    # Hook callers still get a bounded wait for their JSON payload.
    payload = {}
    if not args.title and select.select([sys.stdin], [], [], 1.0)[0]:
        try:
            payload = json.load(sys.stdin)
        except (ValueError, OSError):
            payload = {}

    rex_session = os.environ.get("REX_SESSION") if os.environ.get("HERDR_ENV") != "1" and not args.pane else None
    pane_id = args.pane or (os.environ.get("REX_BLOCK", "") if rex_session else os.environ.get("HERDR_PANE_ID", ""))
    session_id = args.session or payload_value(
        payload, "session_id", "sessionId", "conversation_id", "conversationId"
    )
    cwd = args.cwd or payload_value(payload, "cwd", "directory", "workspace") or os.getcwd()
    # An explicit title also needs no git-root lookup.
    fallback = clean_text(args.title) if args.title and not args.native else project_name(cwd)
    path = state_path(args.kind, session_id, pane_id)
    current = read_state(path)

    event = payload_value(payload, "hook_event_name", "hookEventName", "event")
    prompt = payload_value(payload, "prompt", "user_prompt", "userPrompt", "text", "message")

    title = clean_text(args.title) if args.title else ""
    provisional = False
    if args.native or event.lower() in {"stop", "sessionstop", "afteragentresponse"}:
        title = native_title(args.kind, pane_id, fallback)
    elif title:
        provisional = False
    elif prompt and (not current or current.get("provisional", True)):
        title = shorten_prompt(prompt)
    elif current:
        title = current["title"]
        provisional = bool(current.get("provisional"))
    else:
        title = fallback
        provisional = True

    if not title:
        title = current["title"] if current else fallback
        provisional = bool(current.get("provisional")) if current else True

    write_state(path, title, provisional)
    if rex_session and pane_id:
        report_rex(args.kind, pane_id, title)
    else:
        report(args.kind, pane_id, title)
        name_agent(title, pane_id)


if __name__ == "__main__":
    main()
