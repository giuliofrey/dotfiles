#!/usr/bin/env python3
"""prefix+space, tmux's next-layout: even-horizontal, even-vertical,
main-horizontal, main-vertical, tiled, in that order.

herdr has no layout concept of its own. The socket API exposes no layout
method, and `pane move` is the only re-parenting primitive, so every layout is
rebuilt one pane at a time.

`pane move` refuses a move inside the tab a pane already lives in, answering
changed=false, reason=same_tab. So each pane goes out to a throwaway tab and
straight back in against its new neighbour. herdr closes the empty tab itself
and the pane keeps its ID and its process; the cost is a tab that blinks in and
out of the tab bar once per pane.

All five layouts are the same shape: panes grouped into columns (or rows), the
group heads chained one way, the rest of each group chained the other. Only the
grouping and the two directions change, which is the whole of LAYOUTS below.
"""
import json
import math
import os
import pathlib
import subprocess
import sys

# Which layout each tab is on. herdr reports geometry but not intent, and
# telling main-vertical from tiled by rectangle alone is more code than
# remembering the number. Lives beside herdr's own session.json.
STATE = pathlib.Path.home() / ".config/herdr/flip.state"


def herdr(*args):
    out = subprocess.run(["herdr", *args], capture_output=True, text=True, check=True)
    return json.loads(out.stdout)["result"]


def deal(ids, count):
    """Split ids into `count` consecutive groups, fullest first."""
    groups, start = [], 0
    for c in range(count):
        size = len(ids) // count + (1 if c < len(ids) % count else 0)
        groups.append(ids[start:start + size])
        start += size
    return groups


def grid(ids):
    """Rows of a near-square grid. Rows, not columns, so that reading order
    survives the flip: dealt column-major the panes permute every cycle."""
    return deal(ids, math.ceil(len(ids) / math.ceil(math.sqrt(len(ids)))))


# (grouping, direction between groups, direction inside a group)
LAYOUTS = [
    ("even-horizontal", lambda ids: [[i] for i in ids], "right", "down"),
    ("even-vertical", lambda ids: [[i] for i in ids], "down", "right"),
    ("main-horizontal", lambda ids: [ids[:1], ids[1:]], "down", "right"),
    ("main-vertical", lambda ids: [ids[:1], ids[1:]], "right", "down"),
    ("tiled", grid, "down", "right"),
]

pane = os.environ.get("HERDR_ACTIVE_PANE_ID") or os.environ.get("HERDR_PANE_ID")
layout = herdr("pane", "layout", *(["--pane", pane] if pane else ["--current"]))["layout"]
panes = layout["panes"]
if len(panes) < 2:
    sys.exit(0)

# Visual order, not tree order, so a flip preserves reading order.
panes.sort(key=lambda p: (p["rect"]["y"], p["rect"]["x"]))
ids = [p["pane_id"] for p in panes]
tab, focused = layout["tab_id"], layout["focused_pane_id"]

# Below three panes the five layouts collapse to two distinct shapes, so the
# full cycle would look like the key had stopped working. tmux has the same
# redundancy; there it is just less noticeable.
choices = LAYOUTS if len(ids) > 2 else LAYOUTS[:2]

state = {}
if STATE.exists():
    state = json.loads(STATE.read_text())
index = (state.get(tab, -1) + 1) % len(choices)
name, group_by, outer, inner = choices[index]
state[tab] = index
STATE.write_text(json.dumps(state))

groups = [g for g in group_by(ids) if g]


def move(pane_id, direction, target, ratio):
    herdr("pane", "move", pane_id, "--new-tab", "--no-focus")
    herdr("pane", "move", pane_id,
          "--tab", tab,
          "--split", direction,
          "--target-pane", target,
          # Chained splits nest, so each hands its first child a shrinking
          # share to come out even: 1/n, then 1/(n-1), and so on.
          "--ratio", "%.4f" % ratio,
          "--focus" if pane_id == focused else "--no-focus")


# Group heads first: they carve the tab into columns while each is still a
# single cell. Filling a column before the next one exists would split that one
# cell instead of the column.
for g in range(1, len(groups)):
    move(groups[g][0], outer, groups[g - 1][0], 1 / (len(groups) - g + 1))

for group in groups:
    for j in range(1, len(group)):
        move(group[j], inner, group[j - 1], 1 / (len(group) - j + 1))

print(name)
