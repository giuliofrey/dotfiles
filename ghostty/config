# Ghostty prepends `exec -l` to the command, so a shell builtin like `export`
# at the front is looked up as a binary and fails. Absolute path instead: no
# PATH lookup needed (launchd's PATH has no homebrew), and config.fish runs
# `brew shellenv` anyway.
command = /opt/homebrew/bin/fish --login --interactive
theme = dark:TokyoNight Storm,light:TokyoNight Day
desktop-notifications = true
working-directory = home
window-width = 80
window-height = 24
confirm-close-surface = false
